{
  "name": "youtube-playlist-duration-calculator",
  "description": "An extension to calculate & display the total duration of a youtube playlist.",
  "author": "nrednav",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "vite",
    "build:chrome": "npm run clean && vite build --mode chrome",
    "build:firefox": "npm run clean && vite build --mode firefox",
    "test": "tsx --test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "npm run clean && vite build --watch --mode development",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "check:ci": "biome ci .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "tsx": "4.20.3",
    "vite": "^7.3.6",
    "vite-plugin-web-extension": "^4.4.4",
    "webextension-polyfill": "^0.10.0"
  },
  "dependencies": {},
  "overrides": {
    "adm-zip": "0.6.1",
    "brace-expansion": "1.1.21",
    "fast-uri": "3.1.8",
    "firefox-profile": "4.7.1",
    "nanoid": "3.3.20",
    "postcss": "8.5.30",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici": "7.29.1",
    "vite-plugin-web-extension": {
      "fx-runner": "1.5.0",
      "tmp": "0.2.7"
    }
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,json}": [
      "npm run check"
    ]
  }
}
